# telemetry: simulator | prometheus
TELEMETRY_ADAPTER=simulator
POLL_SECONDS=2
PROM_URL=http://prometheus:9090
# auth: dev | oidc
AUTH_MODE=dev
OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
OIDC_AUDIENCE=dc-aiops
# ticketing: none | servicenow | jira
TICKETING=none
SNOW_INSTANCE=
SNOW_USER=
SNOW_PASS=
SNOW_ASSIGNMENT_GROUP=DC Operations
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJECT=DCOPS
JIRA_DONE_TRANSITION=31
# AI triage (AI-spec)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
AI_MONTHLY_BUDGET_USD=5
# price table, USD per million tokens (budget reserve/settle)
AI_PRICE_IN_PER_M=1.0
AI_PRICE_OUT_PER_M=5.0
# optional SQLite file that keeps month-to-date spend across restarts (unset = in-memory)
AI_BUDGET_DB=
# observability (unset = tracing off, /healthz reports "tracing": "off")
PHOENIX_COLLECTOR_ENDPOINT=
APP_VERSION=dev
