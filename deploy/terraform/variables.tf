# variables.tf — every knob the Phase 4–7 exercise turns.
# Values live in terraform.tfvars (copy terraform.tfvars.example) or TF_VAR_* env vars.
# Secrets (db_password) must come from the environment, never from a committed file.

variable "project" {
  description = "Name prefix for every resource. Also the ECR repository and ECS cluster name."
  type        = string
  default     = "dc-aiops"
}

variable "aws_region" {
  description = "AWS region. ap-south-1 (Mumbai) keeps latency low for the course cohort."
  type        = string
  default     = "ap-south-1"
}

variable "environment" {
  description = "Passed to the container as ENV; the backend refuses AUTH_MODE=dev when this is 'production'."
  type        = string
  default     = "production"
}

# ---------------------------------------------------------------- network ----
variable "vpc_cidr" {
  type    = string
  default = "10.42.0.0/16"
}

variable "public_subnet_cidrs" {
  description = "Two public subnets (ALB, NAT gateway), one per AZ."
  type        = list(string)
  default     = ["10.42.0.0/24", "10.42.1.0/24"]
}

variable "private_subnet_cidrs" {
  description = "Two private subnets (ECS tasks, RDS), one per AZ."
  type        = list(string)
  default     = ["10.42.10.0/24", "10.42.11.0/24"]
}

# ---------------------------------------------------------------- compute ----
variable "image" {
  description = <<-EOT
    Container image for the FIRST task-definition revision only. Terraform ignores later
    changes (the deploy workflow registers new revisions). On a fresh account nothing is in
    ECR yet, so the default is a public placeholder that answers on port 8080; the first
    `gh workflow run deploy.yml` replaces it with the real image.
  EOT
  type        = string
  default     = "public.ecr.aws/docker/library/python:3.12-slim"
}

variable "container_port" {
  description = "Port uvicorn listens on inside the container (Dockerfile EXPOSE 8080)."
  type        = number
  default     = 8080
}

variable "task_cpu" {
  description = "Fargate CPU units. 256 (= 0.25 vCPU) is the smallest and enough for 24 racks at 0.5 Hz."
  type        = number
  default     = 256
}

variable "task_memory" {
  description = "Fargate memory in MiB. 512 is the smallest pairing for 256 CPU."
  type        = number
  default     = 512
}

variable "desired_count" {
  description = "Running API tasks. 1 for the course; the WebSocket poll loop is per-task so >1 means duplicate feeds until a shared broadcaster exists."
  type        = number
  default     = 1
}

variable "app_environment" {
  description = "Non-secret environment variables for the container (see .env.example). Secrets go through Secrets Manager."
  type        = map(string)
  default = {
    TELEMETRY_ADAPTER = "simulator"
    POLL_SECONDS      = "2"
    AUTH_MODE         = "oidc"
    OIDC_ISSUER       = "https://login.microsoftonline.com/<tenant>/v2.0"
    OIDC_AUDIENCE     = "dc-aiops"
    TICKETING         = "none"
  }
}

# --------------------------------------------------------------- database ----
variable "db_instance_class" {
  description = "RDS instance size. db.t4g.micro is free-tier eligible for 12 months and ample for the incident table."
  type        = string
  default     = "db.t4g.micro"
}

variable "db_engine_version" {
  type    = string
  default = "16"
}

variable "db_name" {
  type    = string
  default = "aiops"
}

variable "db_username" {
  type    = string
  default = "aiops"
}

variable "db_password" {
  description = <<-EOT
    Master password. Supply via TF_VAR_db_password from a password manager. It is NOT
    regenerated by Terraform on purpose: a snapshot keeps the password it was taken with,
    so the same value must be presented when rebuilding from a snapshot (Phase 7).
  EOT
  type        = string
  sensitive   = true
}

variable "snapshot_identifier" {
  description = <<-EOT
    Phase 7 restore switch. Empty = create a fresh, empty database. Set to a manual
    snapshot id (deploy/scripts/backup.sh prints it) to rebuild the database WITH its
    incidents, e.g. -var snapshot_identifier=dc-aiops-db-manual-20261017T154210Z
  EOT
  type        = string
  default     = ""
}

# ---------------------------------------------------------- GitHub OIDC ----
variable "github_repo" {
  description = "owner/name of the GitHub repository allowed to assume the deploy role."
  type        = string
}

variable "github_branch" {
  description = "Only workflows running on this branch may deploy (push and workflow_dispatch both carry ref:refs/heads/<branch>)."
  type        = string
  default     = "main"
}

variable "create_github_oidc_provider" {
  description = "An account holds at most ONE OIDC provider for token.actions.githubusercontent.com. Set false if it already exists and the data source will be used."
  type        = bool
  default     = true
}
